<Window x:Class="CataMedia.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CataMedia" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="CataMedia" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,8,0,12" />
            <StackPanel x:Name="ComponentBanner" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="ComponentNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel><Button x:Name="ComponentUpdateButton" Content="{DynamicResource InstallUpdate}" Click="Components_Click" Padding="8,4" />
                    <Button Content="{DynamicResource Later}" Click="Later_Click" Margin="8,0,0,0" Padding="8,4" /></WrapPanel>
            </StackPanel>
            </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DownloadInputs">
                <Label Content="{DynamicResource Language}" Target="{Binding ElementName=LanguageChoice}" />
                <ComboBox x:Name="LanguageChoice" SelectionChanged="OptionsChanged" AutomationProperties.AutomationId="LanguageChoice">
                    <ComboBoxItem Content="Português (Brasil)" /><ComboBoxItem Content="English" />
                </ComboBox>
                <Label Content="{DynamicResource Links}" Target="{Binding ElementName=VideoUrl}" />
                <TextBox x:Name="VideoUrl" AutomationProperties.AutomationId="VideoUrl" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" />
                <Button Content="{DynamicResource Paste}" Click="Paste_Click" HorizontalAlignment="Left" Margin="0,6,0,4" />
                <Label Content="{DynamicResource Destination}" Target="{Binding ElementName=Destination}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource ChooseFolder}" Click="ChooseDestination_Click" Margin="8,0,0,0" Padding="8,4" />
                    <TextBox x:Name="Destination" AutomationProperties.AutomationId="Destination" />
                </DockPanel>
                <Label Content="{DynamicResource MediaType}" Target="{Binding ElementName=MediaChoice}" />
                <ComboBox x:Name="MediaChoice" SelectionChanged="OptionsChanged">
                    <ComboBoxItem Content="{DynamicResource Video}" /><ComboBoxItem Content="{DynamicResource Audio}" />
                </ComboBox>
                <StackPanel x:Name="VideoOptions">
                    <Label Content="{DynamicResource Resolution}" Target="{Binding ElementName=ResolutionChoice}" />
                    <ComboBox x:Name="ResolutionChoice">
                        <ComboBoxItem Content="{DynamicResource UpTo720}" /><ComboBoxItem Content="{DynamicResource UpTo1080}" />
                    </ComboBox>
                    <TextBlock Text="{DynamicResource ResolutionHint}" TextWrapping="Wrap" Margin="0,4,0,8" />
                </StackPanel>
                <StackPanel x:Name="AudioOptions">
                    <Label Content="{DynamicResource AudioFormat}" Target="{Binding ElementName=AudioChoice}" />
                    <ComboBox x:Name="AudioChoice" SelectionChanged="OptionsChanged">
                        <ComboBoxItem Content="MP3" /><ComboBoxItem Content="WAV" /><ComboBoxItem Content="FLAC" />
                    </ComboBox>
                    <StackPanel x:Name="Mp3Options">
                        <Label Content="{DynamicResource AudioQuality}" Target="{Binding ElementName=QualityChoice}" />
                        <ComboBox x:Name="QualityChoice">
                            <ComboBoxItem Content="{DynamicResource Low}" /><ComboBoxItem Content="{DynamicResource Standard}" /><ComboBoxItem Content="{DynamicResource High}" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="LosslessHint" Text="{DynamicResource Lossless}" TextWrapping="Wrap" Margin="0,4,0,8" />
                </StackPanel>
                <Expander Header="{DynamicResource Advanced}" Margin="0,8,0,8">
                    <StackPanel>
                        <TextBlock x:Name="ModeLabel" /><TextBlock x:Name="DataLabel" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <TextBlock Text="{DynamicResource ComponentsHint}" TextWrapping="Wrap" />
                        <Label Content="yt-dlp.exe" Target="{Binding ElementName=YtDlpPath}" />
                        <TextBox x:Name="YtDlpPath" AutomationProperties.AutomationId="YtDlpPath" />
                        <Button Content="{DynamicResource ChooseYtDlp}" Click="ChooseYtDlp_Click" HorizontalAlignment="Left" />
                        <Label Content="{DynamicResource FfmpegFolder}" Target="{Binding ElementName=FfmpegFolder}" />
                        <TextBox x:Name="FfmpegFolder" AutomationProperties.AutomationId="FfmpegFolder" />
                        <Button Content="{DynamicResource ChooseComponents}" Click="ChooseFfmpeg_Click" HorizontalAlignment="Left" />
                        <Label Content="Node.js (YouTube)" Target="{Binding ElementName=NodePath}" />
                        <TextBox x:Name="NodePath" AutomationProperties.AutomationId="NodePath" />
                        <Button Content="{DynamicResource ChooseNode}" Click="ChooseNode_Click" HorizontalAlignment="Left" />
                        <Label Content="{DynamicResource Cookies}" Target="{Binding ElementName=CookiesChoice}" />
                        <ComboBox x:Name="CookiesChoice">
                            <ComboBoxItem Content="{DynamicResource NoCookies}" /><ComboBoxItem Content="Chrome" />
                            <ComboBoxItem Content="Edge" /><ComboBoxItem Content="Firefox" /><ComboBoxItem Content="Brave" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource CookiesHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>
                <Button x:Name="SaveButton" Content="{DynamicResource Save}" AutomationProperties.AutomationId="SavePreferences"
                        Click="Save_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,12" />
            </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Queue}" FontWeight="SemiBold" Margin="0,0,0,8" /><Expander DockPanel.Dock="Bottom" Header="{DynamicResource Details}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DetailsHint}" TextWrapping="Wrap" />
                    <TextBox x:Name="DiagnosticDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Expander>
        <TextBox x:Name="ResultFile" DockPanel.Dock="Bottom" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" />
            <DataGrid x:Name="QueueList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" MinRowHeight="36"
                      SelectionMode="Single" SelectionChanged="QueueSelectionChanged" AutomationProperties.AutomationId="Queue">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="TitleColumn" Binding="{Binding Title}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="4,2" />
                                <Setter Property="ToolTip" Value="{Binding Title}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="FormatColumn" Binding="{Binding Format}" Width="125" />
                    <DataGridTextColumn x:Name="StateColumn" Binding="{Binding Status}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="4,2" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
</DockPanel>
</Grid>
<StackPanel Grid.Row="2">
<WrapPanel Margin="0,8,0,12">
                <Button Content="{DynamicResource Help}" Click="Help_Click" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="ComponentsButton" Content="{DynamicResource Components}" Click="Components_Click" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="DownloadButton" Content="{DynamicResource Download}" Click="Download_Click" AutomationProperties.AutomationId="Download" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="Cancel_Click" AutomationProperties.AutomationId="Cancel" IsEnabled="False" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="RetryButton" Content="{DynamicResource Retry}" Click="Retry_Click" IsEnabled="False" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="OpenFolderButton" Content="{DynamicResource OpenFolder}" Click="OpenFolder_Click" IsEnabled="False" Padding="12,8" />
            </WrapPanel>
            <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="14" Margin="0,0,0,12" />
            <TextBlock x:Name="StatusLabel" AutomationProperties.AutomationId="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
</Grid>
</Window>
