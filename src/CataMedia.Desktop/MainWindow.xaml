<Window x:Class="CataMedia.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CataMedia — Windows" Width="720" Height="740"
        MinWidth="580" MinHeight="480" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="CataMedia" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Vídeo MP4 — um link por vez. / MP4 video — one link at a time."
                       TextWrapping="Wrap" Margin="0,8,0,20" />
            <StackPanel x:Name="DownloadInputs">
            <Label Content="_Link do vídeo / Video link" Target="{Binding ElementName=VideoUrl}" />
            <TextBox x:Name="VideoUrl" AutomationProperties.AutomationId="VideoUrl" />
            <TextBlock x:Name="ModeLabel" TextWrapping="Wrap" />
            <TextBlock x:Name="DataLabel" TextWrapping="Wrap" Margin="0,4,0,16" />
            <Label Content="_Idioma / Language" Target="{Binding ElementName=LanguageChoice}" />
            <ComboBox x:Name="LanguageChoice" AutomationProperties.AutomationId="LanguageChoice">
                <ComboBoxItem Content="Português (Brasil)" /><ComboBoxItem Content="English" />
            </ComboBox>
            <Label Content="_Pasta de destino / Destination folder" Target="{Binding ElementName=Destination}" />
            <TextBox x:Name="Destination" AutomationProperties.AutomationId="Destination" />
            <Button Content="Escolher pasta / Choose folder" Click="ChooseDestination_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
            <Label Content="_Resolução máxima MP4 / Maximum MP4 resolution" Target="{Binding ElementName=ResolutionChoice}" />
            <ComboBox x:Name="ResolutionChoice">
                <ComboBoxItem Content="Até / Up to 720p" /><ComboBoxItem Content="Até / Up to 1080p" />
            </ComboBox>
            <TextBlock Text="A resolução real pode ser menor conforme a origem. / Actual resolution may be lower depending on the source."
                       TextWrapping="Wrap" Margin="0,4,0,8" />
            <Expander Header="Componentes instalados / Installed components" Margin="0,8,0,8">
                <StackPanel>
                    <TextBlock Text="Selecione componentes já instalados. A atualização será acrescentada em uma próxima etapa. / Select existing components. Updating will be added in a later stage."
                               TextWrapping="Wrap" />
                    <Label Content="yt-dlp.exe" Target="{Binding ElementName=YtDlpPath}" />
                    <TextBox x:Name="YtDlpPath" AutomationProperties.AutomationId="YtDlpPath" />
                    <Button Content="Escolher yt-dlp / Choose yt-dlp" Click="ChooseYtDlp_Click" HorizontalAlignment="Left" />
                    <Label Content="Pasta FFmpeg + FFprobe / FFmpeg + FFprobe folder" Target="{Binding ElementName=FfmpegFolder}" />
                    <TextBox x:Name="FfmpegFolder" AutomationProperties.AutomationId="FfmpegFolder" />
                    <Button Content="Escolher componentes / Choose components" Click="ChooseFfmpeg_Click" HorizontalAlignment="Left" />
                    <Label Content="Node.js (YouTube)" Target="{Binding ElementName=NodePath}" />
                    <TextBox x:Name="NodePath" AutomationProperties.AutomationId="NodePath" />
                    <Button Content="Escolher Node.js / Choose Node.js" Click="ChooseNode_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
            <Expander Header="Preferências de áudio para a próxima etapa / Audio preferences for the next stage">
            <StackPanel>
            <Label Content="_Tipo preferido / Preferred type" Target="{Binding ElementName=MediaChoice}" />
            <ComboBox x:Name="MediaChoice">
                <ComboBoxItem Content="Vídeo MP4 / MP4 video" /><ComboBoxItem Content="Só áudio / Audio only" />
            </ComboBox>
            <Label Content="_Formato de áudio / Audio format" Target="{Binding ElementName=AudioChoice}" />
            <ComboBox x:Name="AudioChoice">
                <ComboBoxItem Content="MP3" /><ComboBoxItem Content="WAV" /><ComboBoxItem Content="FLAC" />
            </ComboBox>
            <Label Content="_Qualidade MP3 / MP3 quality" Target="{Binding ElementName=QualityChoice}" />
            <ComboBox x:Name="QualityChoice">
                <ComboBoxItem Content="Baixa / Low" /><ComboBoxItem Content="Padrão / Standard" /><ComboBoxItem Content="Alta / High" />
            </ComboBox>
            </StackPanel>
            </Expander>
            <Button x:Name="SaveButton" Content="_Salvar preferências / Save preferences"
                    AutomationProperties.AutomationId="SavePreferences" Click="Save_Click"
                    HorizontalAlignment="Left" Padding="16,8" Margin="0,20,0,12" />
            </StackPanel>
            <WrapPanel Margin="0,8,0,12">
                <Button x:Name="DownloadButton" Content="_Baixar MP4 / Download MP4" Click="Download_Click"
                        AutomationProperties.AutomationId="Download" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Content="_Cancelar / Cancel" Click="Cancel_Click" IsEnabled="False"
                        AutomationProperties.AutomationId="Cancel" Padding="12,8" Margin="0,0,8,0" />
                <Button x:Name="OpenFolderButton" Content="Abrir pasta / Open folder" Click="OpenFolder_Click"
                        IsEnabled="False" Padding="12,8" />
            </WrapPanel>
            <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="14" Margin="0,0,0,12" />
            <TextBlock x:Name="StatusLabel" AutomationProperties.AutomationId="Status"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</Window>
